{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["canonical", "is-crawlable", "maskable-icon", "offline-start-url", "service-worker"]
      }
    },
    "assert": {
      "assertions": {
        "resource-summary:script:size": ["warn", {"maxNumericValue": 1400}],
        "resource-summary:total:size": ["warn", {"maxNumericValue": 2400}],
        "resource-summary:font:size": ["warn", {"maxNumericValue": 400}],
        "categories:performance": ["warn", {"minScore": 0.5}],
        "categories:accessibility": ["warn", {"minScore": 0.8}],
        "categories:best-practices": ["warn", {"minScore": 0.8}],
        "cumulative-layout-shift": ["warn", {"maxNumericValue": 0.25}],
        "largest-contentful-paint": ["warn", {"maxNumericValue": 6000}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
