# Solis Environment Configuration Template
# Copy this file to .env and provide your project keys.
# NEVER commit the real .env file or production keys.

# Data layer mode: 'supabase' (default for production/connected) or 'mock' (for local offline tests)
VITE_DATA_LAYER=supabase

# Supabase Project Configuration (Browser-Safe Anon Key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-browser-safe-anon-key-here
